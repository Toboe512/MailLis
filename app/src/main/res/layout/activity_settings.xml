    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сервер входящей почты (IMAP)"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editTextImapServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textUri"
        android:minHeight="48dp"
        android:text="imap.mail.ru" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Порт IMAP (SSL/TLS)"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editTextImapPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:text="993" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Сервер исходящей почты (SMTP)"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editTextSmtpServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textUri"
        android:minHeight="48dp"
        android:text="smtp.mail.ru" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Порт SMTP (SSL/TLS)"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editTextSmtpPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:minHeight="48dp"
        android:text="465" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Учетные данные"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editTextEmailLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Логин (example@mail.ru)"
        android:inputType="textEmailAddress" />

    <EditText
        android:id="@+id/editTextEmailPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Пароль"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/buttonTestConnection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Проверить соединение" />

    <Button
        android:id="@+id/buttonSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Сохранить" />

</LinearLayout>

