<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    xmlns:tools="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:ignore="HardcodedText,Autofill">

    <!-- Верхняя панель навигации -->
    <FrameLayout
        android:id="@+id/toolbarContainer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0088CC"
        android:elevation="4dp">

        <RelativeLayout
            android:id="@+id/layoutNormalToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="visible">

            <!-- Кастомная стрелочка назад (слева) -->
            <ImageButton
                android:id="@+id/buttonCreateChatBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Назад"
                app:tint="#FFFFFF" />

            <!-- Текстовое название группы / заголовок -->
            <TextView
                android:id="@+id/textViewCreateChatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/buttonCreateChatBack"
                android:layout_centerVertical="true"
                android:layout_marginLeft="12dp"
                android:text="Создание чата"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true" />
        </RelativeLayout>
    </FrameLayout>

    <!-- Блок добавления нового контакта -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <EditText
            android:id="@+id/editTextContactId"
            android:layout_width="1dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="ID пользователя или телефон"
            android:importantForAutofill="no"
            android:inputType="text" />

        <Button
            android:id="@+id/buttonViewContactTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавить новый контакт"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#D3D3D3" />

        <TextView
            android:id="@+id/textViewGroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Создать групповой чат"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/editTextGroupName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Название группы"
        android:importantForAutofill="no"
        android:inputType="text" />

    <TextView
        android:id="@+id/textViewSelectContactsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Выберите контакты для приглашения:"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#D3D3D3" />

    <!-- Блок создания группового чата -->

    <!-- Список контактов -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSelectContacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/buttonCreateGroup"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:text="Создать группу" />

    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#D3D3D3" />

</LinearLayout>
