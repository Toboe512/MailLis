<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    xmlns:tools="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:ignore="HardcodedText,Autofill">

    <!-- Блок добавления нового контакта -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarCreateChat"
        app:title="Настройки"
        app:titleTextColor="#FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2196F3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!-- Верхняя панель со стрелкой назад -->
        <!--        <Toolbar-->
        <!--            android:id="@+id/toolbarCreateChat"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="56dp"-->
        <!--            android:background="#2196F3"-->
        <!--            android:titleTextColor="#FFFFFF"-->
        <!--            android:title="Создать чат"-->
        <!--            android:navigationIcon="@android:drawable/ic_menu_revert" />-->



        <EditText
            android:id="@+id/editTextContactId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="ID пользователя или телефон"
            android:importantForAutofill="no"
            android:inputType="text" />

        <Button
            android:id="@+id/buttonViewContactTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавить новый контакт"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#D3D3D3" />

        <TextView
            android:id="@+id/textViewGroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Создать групповой чат"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!--        <Button-->
        <!--            android:id="@+id/buttonAddContact"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:text="Добавить" />-->
    </LinearLayout>

    <EditText
        android:id="@+id/editTextGroupName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Название группы"
        android:importantForAutofill="no"
        android:inputType="text" />

    <TextView
        android:id="@+id/textViewSelectContactsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Выберите контакты для приглашения:"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#D3D3D3" />

    <!-- Блок создания группового чата -->


    <!-- Список контактов -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSelectContacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/buttonCreateGroup"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:text="Создать группу" />

    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#D3D3D3" />


</LinearLayout>
