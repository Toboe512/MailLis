<?xml version="1.0" encoding="utf-8"?><!-- Корневой контейнер теперь пускает фон на самый верх экрана -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- СИНИЙ ТУЛБАР: Растягивается наверх и окрашивает область часов -->
    <RelativeLayout
        android:id="@+id/addMembersToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0088CC"
        android:paddingLeft="16dp"
        android:paddingTop="32dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Добавить участников"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- ОСНОВНОЙ КОНТЕНТ: fitsSystemWindows защитит нижнюю часть списка от навигационного бара -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/addMembersToolbar"
        android:fitsSystemWindows="true"
        android:orientation="vertical"> <!-- Добавлено сюда -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Выберите контакт из списка ниже, чтобы пригласить его в текущую P2P-группу:"
            android:textColor="#666666"
            android:textSize="14sp" />

        <ListView
            android:id="@+id/listViewContactsToGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="#00000000"
            android:divider="#E0E0E0"
            android:dividerHeight="1dp" />
    </LinearLayout>

</RelativeLayout>