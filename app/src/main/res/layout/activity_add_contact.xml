<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:ignore="HardcodedText,Autofill">

    <!-- Поля ввода данных нового контакта -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="34dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/addNewContact"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Поле для имени -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contactName"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextContactName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/exampleName"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp" />

        <!-- Поле для Email / ID -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emailMaillis"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextContactEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/exampleMail"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="32dp" />

        <!-- Кнопка сохранения -->
        <Button
            android:id="@+id/buttonSaveContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/addInContact" />

    </LinearLayout>
</LinearLayout>
